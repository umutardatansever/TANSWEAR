@startuml TANSWEAR_Magaza_UML
' ----------------------------------------------------------
'  TANSWEAR Mağaza Otomasyonu — UML Sınıf Diyagramı
'  PlantUML kaynak dosyası (Paket Yapısı ile Düzenlenmiş)
' ----------------------------------------------------------
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
hide empty members

' ===== MODEL PAKETİ =====
package model {
  abstract class Kullanici {
    # kullaniciAdi : String
    # sifre : String
    + getKullaniciAdi() : String
    + getSifre() : String
    + kullaniciSatiri() : String
    + {abstract} menu() : void
  }

  class Admin {
    - magaza : Magaza
    + Admin(ad, sifre, magaza)
    + getMagaza() : Magaza
  }

  class Musteri {
    - magaza : Magaza
    - bakiye : double
    + getBakiye() : double
    + paraCek(miktar) : boolean
  }

  interface SatinAlabilir {
    + satinAl() : boolean
  }

  abstract class Urun {
    - ad : String
    - fiyat : double
    - stok : int
    + getAd() : String
    + getFiyat() : double
    + getStok() : int
    + setStok(int)
    + stokAzalt(int)
    + getTur() : String
    + satinAl() : boolean
    + {abstract} bilgiGoster() : void
  }

  abstract class Kiyafet {
    # beden : String
    # renk : String
    # resimYolu : String
  }

  class Gomlek
  class Pantolon
  class Ceket

  class Sepet {
    - urunler : ArrayList<Urun>
    - indirimStratejisi : IndirimStratejisi
    + urunEkle(Urun)
    + urunCikar(String)
    + toplamTutar() : double
    + satinAl() : boolean
  }

  Kullanici <|-- Admin
  Kullanici <|-- Musteri

  Urun ..|> SatinAlabilir
  Urun <|-- Kiyafet
  Kiyafet <|-- Gomlek
  Kiyafet <|-- Pantolon
  Kiyafet <|-- Ceket

  Sepet ..|> SatinAlabilir
  Sepet o-- "*" Urun
}

' ===== PATTERNS.SINGLETON =====
package patterns.singleton {
  class Magaza << (S,#FFAA00) Singleton >> {
    - {static} instance : Magaza
    - urunListesi : ArrayList<Urun>
    - gozlemciler : ArrayList<Observer>
    - Magaza()
    + {static} getInstance() : Magaza
    + urunEkle(Urun)
    + urunSil(String)
    + stokGuncelle(String, int)
    + dosyadanUrunEkle()
  }
}

' ===== PATTERNS.FACTORYMETHOD =====
package patterns.factorymethod {
  class UrunFactory << (F,#88CCFF) Factory >> {
    + {static} createUrun(tur, ad, ...) : Urun
  }
}

' ===== PATTERNS.ABSTRACTFACTORY =====
package patterns.abstractfactory {
  interface KoleksiyonFabrikasi << Abstract Factory >> {
    + ustGiyimUret(...) : Urun
    + altGiyimUret(...) : Urun
    + koleksiyonAdi() : String
  }

  class YazlikKoleksiyonFabrikasi
  class KislikKoleksiyonFabrikasi

  KoleksiyonFabrikasi <|.. YazlikKoleksiyonFabrikasi
  KoleksiyonFabrikasi <|.. KislikKoleksiyonFabrikasi
}

' ===== PATTERNS.ADAPTER =====
package patterns.adapter {
  interface OdemeSistemi << Target >> {
    + odemeYap(miktarTL, kartSahibi) : boolean
  }

  class DisBankaSistemi << Adaptee >> {
    + disBankaOdemeAl(musteriIsmi, miktarDolar) : boolean
  }

  class BankaAdapter << Adapter >> {
    - disBanka : DisBankaSistemi
    + odemeYap(miktarTL, kartSahibi) : boolean
  }

  OdemeSistemi <|.. BankaAdapter
}

' ===== PATTERNS.DECORATOR =====
package patterns.decorator {
  interface Fiyatlanabilir << Component >> {
    + getTutar() : double
    + aciklamaGetir() : String
  }

  abstract class SepetDecorator << Decorator >>
  class HediyePaketiDecorator
  class HizliKargoDecorator

  Fiyatlanabilir <|.. SepetDecorator
  SepetDecorator <|-- HediyePaketiDecorator
  SepetDecorator <|-- HizliKargoDecorator
}

' ===== PATTERNS.OBSERVER =====
package patterns.observer {
  interface Subject {
    + gozlemciEkle(Observer)
    + gozlemciCikar(Observer)
    + gozlemcilereHaberVer()
  }

  interface Observer {
    + guncelle()
  }
}

' ===== PATTERNS.STRATEGY =====
package patterns.strategy {
  interface IndirimStratejisi << Strategy >> {
    + indirimHesapla(double) : double
  }
  class IndirimYok
  class YuzdeOnIndirim
  class YuzdeYirmiIndirim

  IndirimStratejisi <|.. IndirimYok
  IndirimStratejisi <|.. YuzdeOnIndirim
  IndirimStratejisi <|.. YuzdeYirmiIndirim
}

' ===== GUI PAKETİ =====
package gui {
  class GirisEkrani
  class AdminPaneliGUI
  class MusteriPaneliGUI
  class ModernButton
  class UIThemes
}

' ===== UTIL PAKETİ =====
package util {
  class DosyaIslemleri << Utility >>
  class KullaniciIslemleri << Utility >>
}

' ===== DIŞ İLİŞKİLER VE BAĞLANTILAR =====
Magaza ..|> patterns.observer.Subject
Magaza "1" o-- "*" Urun
Magaza "1" o-- "*" patterns.observer.Observer

UrunFactory ..> Urun : creates
UrunFactory ..> Gomlek : creates
UrunFactory ..> Pantolon : creates
UrunFactory ..> Ceket : creates

YazlikKoleksiyonFabrikasi ..> Gomlek : ust
YazlikKoleksiyonFabrikasi ..> Pantolon : alt
KislikKoleksiyonFabrikasi ..> Ceket : ust
KislikKoleksiyonFabrikasi ..> Pantolon : alt

Fiyatlanabilir <|.. Sepet
SepetDecorator o-- Fiyatlanabilir : sarmalar
Sepet --> IndirimStratejisi : kullanır

BankaAdapter --> DisBankaSistemi : delegates

AdminPaneliGUI ..|> patterns.observer.Observer
MusteriPaneliGUI ..|> patterns.observer.Observer

GirisEkrani --> Magaza
AdminPaneliGUI --> Magaza
MusteriPaneliGUI --> Magaza
MusteriPaneliGUI --> Sepet
MusteriPaneliGUI --> BankaAdapter

Magaza --> DosyaIslemleri
GirisEkrani --> DosyaIslemleri
GirisEkrani --> KullaniciIslemleri
AdminPaneliGUI --> DosyaIslemleri
MusteriPaneliGUI --> DosyaIslemleri

@enduml
